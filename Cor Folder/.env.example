# Google Maps Platform
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional OpenAI Responses API explanation layer
OPENAI_API_KEY=optional_openai_api_key
# Set this to a model enabled for your OpenAI API project.
OPENAI_MODEL=gpt-6-luna

# Database
DATABASE_URL=sqlite:///./tourism.db

# Application
APP_NAME=Tourism Intelligence Backend
APP_VERSION=2.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost
RATE_LIMIT_PER_MINUTE=120
GOOGLE_TIMEOUT_SECONDS=20
GOOGLE_RETRIES=2
OPENAI_TIMEOUT_SECONDS=30
OPENAI_RETRIES=2
AUTO_CREATE_DB=false
LOG_LEVEL=INFO
